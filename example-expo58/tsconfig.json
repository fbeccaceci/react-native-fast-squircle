{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "react-native-fast-squircle": ["../src/index.tsx"],
      "react": ["./node_modules/@types/react"],
      "react-native": [
        "./node_modules/react-native/types_generated/index.d.ts"
      ],
      "react-native/*": ["./node_modules/react-native/types_generated/*"]
    }
  },
  "include": ["*.ts", "*.tsx"]
}
